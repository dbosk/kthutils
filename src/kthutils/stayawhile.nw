                       self._queue_path(queue, "interaction_log"),
                       params=date_range_params(from_date,
                                                until,
                                                type=interaction_type),
                       use_api_key=True)


def get_queue_log(self, queue, from_date=None, until=None):
  """Return queue log entries for `queue`."""
  return self._request("GET",
                       self._queue_path(queue, "queue_log"),
                       params=date_range_params(from_date, until),
                       use_api_key=True)


def get_queue_events(self, queue, from_date=None, until=None):
  """Return open/close events for `queue`."""
  return self._request("GET",
                       self._queue_path(queue, "queue_events"),
                       params=date_range_params(from_date, until),
