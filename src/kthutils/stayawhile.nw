The booking upload is the one mutation that can partially succeed, so it
is not silent: unresolved identifiers are reported and the exit status
is~1, because a script that syncs bookings from Canvas should notice that
some students were dropped.
Clearing reports the number of deleted bookings on standard error, where it
informs an interactive user without polluting a pipeline.
<<command definitions>>=
@bookings_cli.command(name="ls")
def cli_list_bookings(
    queue: Annotated[str, queue_arg],
    show_provider_id: Annotated[bool, show_provider_id_opt] = False):
  """List bookings for one queue."""
  print_records(get_session().list_bookings(queue),
                BOOKING_FIELDS,
                show_provider_id=show_provider_id)


@bookings_cli.command(name="upsert")
def cli_upsert_bookings(queue: Annotated[str, queue_arg],
                        source: Annotated[str, bookings_source_arg]):
  """Upload bookings from a JSON document."""
  try:
    session = get_session()
    bookings = load_json_input(source)
    result = session.upsert_bookings(queue, bookings)
  except Exception as err:
    logging.error("booking upload failed for %s: %s", queue, err)
    raise typer.Exit(code=1)

  skipped = result.get("skipped") if isinstance(result, dict) else None
  if skipped:
    logging.error("booking upload for %s skipped unresolved identifiers: %s",
                  queue, ", ".join(map(str, skipped)))
    raise typer.Exit(code=1)


@bookings_cli.command(name="clear")
def cli_clear_bookings(queue: Annotated[str, queue_arg],
                       from_date: Annotated[Optional[str],
                                            from_opt] = None,
                       until: Annotated[Optional[str],
                                        until_opt] = None):
  """Delete future bookings for one queue."""
  try:
    result = get_session().clear_bookings(queue,
                                         from_date=from_date,
                                         until=until)
  except Exception as err:
    logging.error("booking clear failed for %s: %s", queue, err)
    raise typer.Exit(code=1)

  if isinstance(result, dict) and "deleted" in result:
    typer.echo(f"deleted {result['deleted']} bookings", err=True)


