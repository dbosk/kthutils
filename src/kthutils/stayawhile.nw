import urllib.parse
@

Most API endpoints require an [[Authorization: Token]] header, but the token
source differs: [[ApiAuth]] endpoints use the long-lived API key (managed by
the user), while the [[Auth]] endpoints use the session JWT from the OAuth2
login.
The public endpoints ([[/api/queues]], a single queue, and its live entries)
are the exception: they should work without triggering browser login at all.
The flags on [[_request]] therefore choose among three modes: no
authentication, API-key authentication, or session-token authentication.
<<[[StayawhileSession]] methods>>=
def _request(self,
             method,
             path,
             *,
             params=None,
             payload=None,
             use_api_key=False,
             use_auth=True):
  headers = None
  if use_api_key:
    headers = {"Authorization": f"Token {self.require_api_key()}"}
  elif use_auth and self.__auth_handler is not None:
    headers = self.__auth_handler.authorization_headers(self.__session)

  response = self.__session.request(
      method,
      f"{self.base_url}{path}",
      headers=headers,
      params=params,
      json=payload)

  response.raise_for_status()

  if response.status_code == 204:
    return None

  try:
    return response.json()
  except ValueError:
    return response.text


def require_api_key(self):
  """Return the configured API key or raise a helpful error."""
  if self.api_key is None:
    self.api_key = get_api_key()
  return self.api_key
