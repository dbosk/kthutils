\subsection{Output formatting}

The commands that read tabular data should adapt to their output target.
When we print to a terminal, a clean table is easier to scan.
When we print to a pipe or file, tab-separated CSV is easier to post-process
with standard POSIX tools such as [[cut]].
<<helper functions>>=
def is_tty():
  """Return whether standard output is a terminal."""
  return sys.stdout.isatty()


def value_to_text(value):
  """Return a stable textual representation of `value`."""
  if value is None:
    return ""
  if isinstance(value, bool):
    return str(value).lower()
  if isinstance(value, (dict, list)):
    return json.dumps(value)
  return str(value)


def print_csv_rows(rows, fields, headers=None):
  """Print `rows` as CSV with the given `fields`."""
  writer = csv.writer(sys.stdout, delimiter="\t")
  writer.writerow(headers or fields)
  for row in rows:
    writer.writerow([value_to_text(row.get(field)) for field in fields])


def print_rich_table(rows, fields, headers=None):
  """Print `rows` as a clean Rich table."""
  table = Table(box=None, show_edge=False, pad_edge=False)
  for header in headers or fields:
    table.add_column(header)
  for row in rows:
    table.add_row(*[value_to_text(row.get(field)) for field in fields])

  Console(file=sys.stdout).print(table)


def print_records(rows,
                  fields,
                  headers=None,
                  tty=None,
                  today=None,
                  show_provider_id=False):
  """Print tabular `rows` either as Rich output or as CSV."""
  original_fields = list(fields)
  headers = filter_headers(original_fields,
                           headers,
                           show_provider_id=show_provider_id)
  fields = visible_fields(original_fields,
                          show_provider_id=show_provider_id)
  rows = [format_output_data(row,
                             today=today,
                             show_provider_id=show_provider_id)
          for row in rows]
  if tty is None:
    tty = is_tty()

  if tty:
    print_rich_table(rows, fields, headers=headers)
  else:
    print_csv_rows(rows, fields, headers=headers)
@

Some replies have no fixed shape worth hard-coding---the statistics in
particular are still evolving on the server side.
For those we infer the columns from the data: a list of flat objects
becomes a table with the union of their keys, in first-seen order.
A single object with nested values (such as the session detail, which is
two arrays) would only become a one-row table of JSON blobs, so nested
objects fall back to formatted JSON instead.
An empty list has no columns to infer, so it prints nothing at all rather
than an empty header line; a pipeline then sees no rows, which is the
truth.
<<helper functions>>=
def infer_record_fields(rows):
  """Return a stable field order inferred from `rows`."""
  fields = []
  seen = set()
  for row in rows:
    if not isinstance(row, dict):
      return None
    for field in row:
      if field not in seen:
        seen.add(field)
        fields.append(field)
  return fields


def is_nested(data):
  """Return whether the dict `data` has list or dict values."""
  return any(isinstance(value, (dict, list)) for value in data.values())


def print_inferred_records(data, *, show_provider_id=False):
  """Print `data` tabular when its fields can be inferred."""
  if isinstance(data, dict) and not is_nested(data):
    print_records([data], list(data.keys()),
                  show_provider_id=show_provider_id)
    return

  if isinstance(data, list):
    if not data:
      return
    fields = infer_record_fields(data)
    if fields is not None:
      print_records(data, fields, show_provider_id=show_provider_id)
      return

  print_json(data, show_provider_id=show_provider_id)


def extract_created_api_key(data):
  """Return the newly created API key string from `data`."""
  if not isinstance(data, dict):
    raise ValueError(f"unexpected create-api-key response: {data!r}")

  value = data.get("token")
  if isinstance(value, str) and value:
    return value

  raise ValueError(f"create-api-key response lacks token: {data!r}")
@

Timestamps and durations are the fields a human reads most, and the raw
ISO~8601 and seconds the API returns are hard to scan in a table.
We therefore format by field name: every timestamp field the API has
(across all families) is listed once, and [[duration_secs]] is the one
duration.
Identifiers ([[provider_id]] and friends) are hidden by default and shown
on request, since a TA rarely needs them and they widen every table.
<<helper functions>>=
TIMESTAMP_FIELDS = {
  "booking_time",
  "checkin_time",
  "checkout_time",
  "created",
  "created_at",
  "ended_at",
  "expires",
  "expires_at",
  "help_started_at",
  "helpstarttime",
  "joined_at",
  "lab_end",
  "lab_start",
  "last_helped_at",
  "occurred_at",
  "slot_time",
  "started_at",
  "starttime",
  "time",
  "uploaded_at",
}

DURATION_FIELDS = {
  "duration_secs",
}


def is_provider_id_field(field):
  """Return whether `field` is a provider-id field."""
  return "provider_id" in field


def visible_fields(fields, *, show_provider_id=False):
  """Return the fields that should be shown."""
  if show_provider_id:
    return list(fields)
  return [field for field in fields if not is_provider_id_field(field)]


def filter_headers(fields, headers, *, show_provider_id=False):
  """Return headers filtered in the same way as `fields`."""
  if headers is None:
    return None

  return [header for field, header in zip(fields, headers)
          if show_provider_id or not is_provider_id_field(field)]


def print_json(data, *, today=None, show_provider_id=False):
  """Print `data` as formatted JSON."""
  print(json.dumps(format_output_data(data,
                                      today=today,
                                      show_provider_id=show_provider_id),
                   indent=2))


def parse_timestamp(timestamp):
  """Return `timestamp` as a `datetime`, when possible."""
  if not timestamp:
    return None

  return datetime.datetime.fromisoformat(
      timestamp.replace("Z", "+00:00"))


def format_timestamp(timestamp, *, today=None):
  """Format `timestamp` compactly for CLI output."""
  parsed = parse_timestamp(timestamp)
  if parsed is None:
    return ""

  if today is None:
    today = datetime.date.today()

  if parsed.date() == today:
    return parsed.strftime("%H:%M")
  return parsed.strftime("%Y-%m-%d %H:%M")


def format_duration(duration_secs):
  """Return `duration_secs` in a compact human-readable form."""
  if duration_secs in (None, ""):
    return ""

  total_seconds = int(duration_secs)
  hours, remainder = divmod(total_seconds, 3600)
  minutes, seconds = divmod(remainder, 60)
  parts = []

  if hours:
    parts.append(f"{hours}h")
  if minutes:
    if hours:
      parts.append(f"{minutes:02d}m")
    else:
      parts.append(f"{minutes}m")
  if seconds or not parts:
    if hours or minutes:
      parts.append(f"{seconds:02d}s")
    else:
      parts.append(f"{seconds}s")

  return " ".join(parts)


def format_field_value(field, value, *, today=None):
  """Return `value` formatted for `field`."""
  if field in TIMESTAMP_FIELDS:
    return format_timestamp(value, today=today)
  if field in DURATION_FIELDS:
    return format_duration(value)
  return value


def format_output_data(data, *, today=None, show_provider_id=False):
  """Return formatted Stay A While output data."""
  if isinstance(data, list):
    return [format_output_data(item,
                               today=today,
                               show_provider_id=show_provider_id)
            for item in data]

  if isinstance(data, dict):
    formatted = {}
    for key, value in data.items():
      if not show_provider_id and is_provider_id_field(key):
        continue

      if isinstance(value, (dict, list)):
        formatted[key] = format_output_data(
            value, today=today, show_provider_id=show_provider_id)
      else:
        formatted[key] = format_field_value(key, value, today=today)
    return formatted

  return data
