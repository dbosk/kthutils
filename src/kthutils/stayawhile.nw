def test_cli_booking_and_assistant_mutations_log_errors(monkeypatch, caplog,
                                                        tmp_path):
  class FailingSession(FakeStayawhileSession):
    def upsert_bookings(self, queue, bookings):
      self.calls.append(("upsert_bookings", queue, bookings))
      raise RuntimeError("boom")

    def clear_bookings(self, queue, from_date=None, until=None):
      self.calls.append(("clear_bookings", queue, from_date, until))
      raise RuntimeError("boom")

    def add_assistant(self, queue, username):
      self.calls.append(("add_assistant", queue, username))
      raise RuntimeError("boom")

    def remove_assistant(self, queue, username):
      self.calls.append(("remove_assistant", queue, username))
      raise RuntimeError("boom")

  fake = FailingSession()
  monkeypatch.setattr(kthutils.stayawhile, "get_session", lambda: fake)
  bookings_file = tmp_path / "bookings.json"
  bookings_file.write_text(
      '[{"provider_id": "u1abc123", "slot_time": "2026-03-01T10:00:00Z"}]')

  upsert = runner.invoke(kthutils.stayawhile.cli,
                         ["bookings", "upsert", "Queue",
                          str(bookings_file)])
  clear = runner.invoke(kthutils.stayawhile.cli,
                        ["bookings", "clear", "Queue"])
  add = runner.invoke(kthutils.stayawhile.cli,
                      ["assistants", "add", "Queue", "abcde"])
  remove = runner.invoke(kthutils.stayawhile.cli,
                         ["assistants", "rm", "Queue", "abcde"])

  assert upsert.exit_code == 1
  assert clear.exit_code == 1
  assert add.exit_code == 1
  assert remove.exit_code == 1
  assert "booking upload failed for Queue: boom" in caplog.text
  assert "booking clear failed for Queue: boom" in caplog.text
  assert "assistant add failed for Queue/abcde: boom" in caplog.text
  assert "assistant remove failed for Queue/abcde: boom" in caplog.text
